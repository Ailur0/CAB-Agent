graph TB
    subgraph "User Interface Layer"
        UI[Teams Bot / Web API / CLI]
    end

    subgraph "Mixture of Experts Layer"
        Router[Router Agent<br/>Intelligent Orchestrator]
        
        subgraph "Specialist Agents"
            CRMgmt[CR Management Agent<br/>CRUD Operations]
            Validation[Validation Agent<br/>Compliance & Conflicts]
            Approval[Approval Agent<br/>Approval Workflows]
            PIR[PIR Agent<br/>Post-Implementation]
            Notification[Notification Agent<br/>Communications]
        end
    end

    subgraph "Tools & Services Layer"
        AzDO[Azure DevOps API]
        Calendar[Calendar API]
        DB[(SQL Server Database)]
        Teams[Teams Notifications]
    end

    subgraph "Background Processing Layer"
        subgraph "Scalable Polling Service"
            Scheduler[Scheduler<br/>APScheduler]
            IncSync[Incremental Sync<br/>Every 5 min]
            FullSync[Full Sync<br/>Weekly]
            BatchProc[Batch Processor<br/>100 CRs/batch]
            WorkerPool[Worker Pool<br/>10 parallel workers]
        end
        
        subgraph "Distributed Task Queue"
            Redis[(Redis<br/>Message Broker)]
            CeleryWorker[Celery Workers<br/>10-50 workers]
            CeleryBeat[Celery Beat<br/>Scheduler]
            Flower[Flower<br/>Monitoring UI]
        end
        
        subgraph "Health Monitoring"
            HealthCheck[Health Monitor]
            Metrics[Metrics Tracker]
            Alerts[Alert System]
        end
    end

    UI --> Router
    Router --> CRMgmt
    Router --> Validation
    Router --> Approval
    Router --> PIR
    Router --> Notification

    CRMgmt --> AzDO
    Validation --> AzDO
    Validation --> Calendar
    Approval --> Teams
    PIR --> AzDO
    Notification --> Teams

    CRMgmt --> DB
    Validation --> DB
    Approval --> DB
    PIR --> DB

    Scheduler --> IncSync
    Scheduler --> FullSync
    IncSync --> BatchProc
    FullSync --> BatchProc
    BatchProc --> WorkerPool
    WorkerPool --> AzDO
    WorkerPool --> DB

    CeleryBeat --> CeleryWorker
    CeleryWorker --> Redis
    CeleryWorker --> DB
    CeleryWorker --> Notification

    HealthCheck --> DB
    HealthCheck --> Scheduler
    HealthCheck --> Redis
    HealthCheck --> Metrics

