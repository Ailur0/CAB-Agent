# Azure Bot Configuration
MICROSOFT_APP_ID=your_bot_app_id_here
MICROSOFT_APP_PASSWORD=your_bot_app_password_here
MICROSOFT_APP_TYPE=MultiTenant

# Microsoft Graph API Configuration
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Azure DevOps / TFS Configuration
# For Azure DevOps Cloud: https://dev.azure.com/{org}/{project}
# For TFS/Azure DevOps Server: https://{server}/tfs/{collection}/{project}
AZURE_DEVOPS_SERVER_URL=https://tfs.realpage.com/tfs
AZURE_DEVOPS_COLLECTION=Realpage
AZURE_DEVOPS_PROJECT=Change_Management
AZURE_DEVOPS_PAT=your_personal_access_token
# Legacy fields (kept for backward compatibility)
AZURE_DEVOPS_ORG=Realpage

# Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string
COSMOS_DB_ENDPOINT=your_cosmos_db_endpoint
COSMOS_DB_KEY=your_cosmos_db_key
COSMOS_DB_DATABASE=change_management
COSMOS_DB_CONTAINER=conversation_references

# Bot Server Configuration
BOT_PORT=3978
BOT_HOST=0.0.0.0

# ADK Configuration
ADK_MODEL=gemini-1.5-flash
ADK_TEMPERATURE=0.7

# Approval Workflow Configuration
APPROVAL_TIMEOUT_MINUTES=30
ESCALATION_MANAGER_EMAIL=manager@example.com

# Logging
LOG_LEVEL=INFO
